{
  "mcpServers": {
    "rea": {
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@latest",
        "mcp"
      ]
    },
    "agent-desktop": {
      "command": "npx",
      "args": [
        "-y",
        "agent-desktop@latest",
        "mcp"
      ]
    },
    "ai-memory": {
      "command": "ai-memory",
      "args": [
        "serve",
        "--transport",
        "stdio"
      ]
    }
  }
}
