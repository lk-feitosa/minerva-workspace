{
  "mcpServers": {
    "magicpath": {
      "url": "https://api.magicpath.ai/mcp"
    },
    "rea": {
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@latest",
        "mcp"
      ]
    },
    "agent-desktop": {
      "command": "npx",
      "args": [
        "-y",
        "agent-desktop@latest",
        "mcp"
      ]
    },
    "ai-memory": {
      "command": "ai-memory",
      "args": [
        "serve",
        "--transport",
        "stdio"
      ]
    },
    "kan": {
      "command": "npx",
      "args": [
        "-y",
        "@kan.bn/mcp"
      ],
      "env": {
        "KAN_BASE_URL": "https://kan.bn",
        "KAN_API_TOKEN": "YOUR_KAN_API_TOKEN"
      }
    }
  }
}
